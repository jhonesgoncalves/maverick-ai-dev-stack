{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.tsx", "bin/**/*.js", "test/**/*.js"]
}
