+  private async listByCursor(query: ListOrdersDto, max: number): Promise<OrdersPage> {
+    const limit = Math.min(query.limit ?? this.config.get<number>('orders.defaultPageSize', 20), max);
+    const cursor = query.cursor ? decodeCursor(query.cursor) : undefined;
+    const key = `orders:${query.customerId ?? '*'}:${query.status ?? '*'}:cursor:${query.cursor ?? ''}:${limit}`;
+    return this.cache.wrap<OrdersPage>(key, 30, async () => {
+      const rows = this.orders.all()
+        .sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id))
+        .filter(order => (!query.customerId || order.customerId === query.customerId) && (!query.status || order.status === query.status) && (!cursor || after(order, cursor)));
+      const data = rows.slice(0, limit);
+      return { data, limit, nextCursor: rows.length > limit ? encodeCursor(data[data.length - 1]) : undefined };
+    });
+  }
