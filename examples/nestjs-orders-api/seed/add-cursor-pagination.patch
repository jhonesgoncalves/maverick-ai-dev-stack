+/** Cursor pages carry `limit`/`nextCursor`; legacy offset pages carry `page`/`pageSize`/`total`. */
+export interface OrdersPage {
+  data: Order[];
+  limit?: number;
+  nextCursor?: string;
+  page?: number;
+  pageSize?: number;
+  total?: number;
+}
+
+const encodeCursor = (order: Order): string => Buffer.from(`${order.createdAt}|${order.id}`).toString('base64url');
+
+function decodeCursor(cursor: string): { createdAt: string; id: string } {
+  const [createdAt, id] = Buffer.from(cursor, 'base64url').toString('utf8').split('|');
+  if (!createdAt || !id || Number.isNaN(Date.parse(createdAt))) throw new BadRequestException('invalid cursor');
+  return { createdAt, id };
+}
+
+const after = (order: Order, cursor: { createdAt: string; id: string }): boolean =>
+  order.createdAt > cursor.createdAt || (order.createdAt === cursor.createdAt && order.id > cursor.id);
+
